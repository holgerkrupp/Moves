    "The Watch app and complications provide supported recording and status controls when installed and paired. iPhone and Watch behavior can differ; use the status shown on the device that is recording to confirm a session." :     {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The Watch app and complications provide supported recording and status controls when installed and paired. iPhone and Watch behavior can differ; use the status shown on the device that is recording to confirm a session."
          }
        }
      }
    },
    "The place detail screen can show other visits associated with the same place, helping you compare dates and correct labels. Changing a saved place definition may affect how visits are recognized." :     {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The place detail screen can show other visits associated with the same place, helping you compare dates and correct labels. Changing a saved place definition may affect how visits are recognized."
          }
        }
      }
    },
    "The radius controls how close a visit must be to match. Nearby or overlapping saved areas can make a match ambiguous; review the visit label after changing definitions." :     {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The radius controls how close a visit must be to match. Nearby or overlapping saved areas can make a match ambiguous; review the visit label after changing definitions."
          }
        }
      }
    },
    "The session records more frequent GPS locations and uses more battery. It is time-limited; use the status shown in Moves, Live Activity, or Watch when available to check whether it is active." :     {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The session records more frequent GPS locations and uses more battery. It is time-limited; use the status shown in Moves, Live Activity, or Watch when available to check whether it is active."
          }
        }
      }
    },
