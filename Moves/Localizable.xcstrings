    "A local export, backup file, or upload to an external location service is a separate action. Do not assume these copies are synchronized or automatically refreshed." :     {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A local export, backup file, or upload to an external location service is a separate action. Do not assume these copies are synchronized or automatically refreshed."
          }
        }
      }
    },
    "A manual export or scheduled iCloud Drive backup is a separate file copy. iCloud sync keeps app data available across devices and does not create an independently browsable backup file." :     {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A manual export or scheduled iCloud Drive backup is a separate file copy. iCloud sync keeps app data available across devices and does not create an independently browsable backup file."
          }
        }
      }
