      {
        "comment": "",
        "key": "Tracking Modes",
        "location": {
          "startingColumn": 22,
          "startingLine": 883
        }
      },
      {
        "comment": "",
        "key": "Background tracking uses iOS visit monitoring and significant location changes to record places and movement with low energy use. When this is off, Moves stops background listening until you turn it on again or start temporary route tracking.",
        "location": {
          "startingColumn": 22,
          "startingLine": 893
        }
      },
      {
        "comment": "",
        "key": "Listen for location changes",
        "location": {
          "startingColumn": 21,
          "startingLine": 888
        }
      },
      {
        "comment": "",
        "key": "Real Route Tracking",
        "location": {
          "startingColumn": 22,
          "startingLine": 901
        }
      },
      {
        "comment": "",
        "key": "Use frequent GPS updates for the actual route when you need more detail. Battery use increases while this is on.",
        "location": {
          "startingColumn": 22,
          "startingLine": 905
        }
      },
      {
        "comment": "",
        "key": "These safeguards can end the session early if power gets tight.",
        "location": {
          "startingColumn": 26,
          "startingLine": 962
        }
      },
      {
        "comment": "",
        "key": "iOS asks for notification permission the first time. If notifications are blocked, open Settings to allow them.",
        "location": {
          "startingColumn": 26,
          "startingLine": 966
        }
      },
      {
        "comment": "",
